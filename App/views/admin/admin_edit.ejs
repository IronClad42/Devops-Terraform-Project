<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>

<style>
    body {
        font-family: Arial, sans-serif;
        background: #f4f6f8;
        padding: 20px;
    }

    h1 {
        margin-bottom: 15px;
        color: #333;
    }

    a {
        text-decoration: none;
        color: #007bff;
    }

    .container {
        background: #fff;
        padding: 20px;
        border-radius: 8px;
        margin-bottom: 30px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        max-width: 800px;
        align-items: center !important;
        margin-left: 27%;
    }

    label {
        font-weight: bold;
        display: block;
        margin-bottom: 5px;
    }

    input {
        width: 100%;
        padding: 8px;
        margin-bottom: 15px;
        border: 1px solid #ccc;
        border-radius: 5px;
    }

    button {
        background: #007bff;
        color: #fff;
        padding: 8px 15px;
        border: none;
        border-radius: 5px;
        cursor: pointer;
    }

    button:hover {
        background: #0056b3;
    }

    table {
        width: 100%;
        border-collapse: collapse;
        background: #fff;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    }

    table th, table td {
        padding: 10px;
        text-align: center;
        border-bottom: 1px solid #ddd;
    }

    table th {
        background: #007bff;
        color: #fff;
    }

    img {
        border-radius: 5px;
    }

    .action-btn button {
        margin: 2px;
        padding: 5px 10px;
    }

    .delete-btn {
        background: #dc3545;
    }

    .delete-btn:hover {
        background: #b52a37;
    }
</style>

<body>
<div class="container">
    <h1>Admin Edit <a href="/admin">Home</a></h1>

    <form action="/admin/admin_edit/<%-info.adminside_id%>" method="post" enctype="multipart/form-data">

        <label>Enter Name</label>
        <input type="text" name="admin_name" value="<%-info.admin_name%>">

        <label>Enter Phone Number</label>
        <input type="text" name="phone_number" value="<%-info.phone_number%>">

        <label>Enter Email</label>
        <input type="email" name="admin_email" value="<%-info.admin_email%>">

        <label>Enter Admin Image</label>
        <input type="file" name="admin_image" accept="image/*">

        <button>Update</button>
    </form>
</div>


</body>
</html>